# Konfiguracja szwagierpoleca.pl

# URL witryny
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE (Baza danych, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# STRIPE (Płatności, Subskrypcje VIP)
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ID Planów Cenowych Stripe dla Klubu Szwagra VIP
STRIPE_PRICE_ID_VIP_MONTHLY=price_vip_monthly_szwagier
STRIPE_PRICE_ID_VIP_YEARLY=price_vip_yearly_szwagier
